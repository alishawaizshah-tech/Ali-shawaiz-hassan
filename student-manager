import os

FILE = "data.txt"

def add_student():
    name = input("Enter student name: ")
    marks = input("Enter marks: ")

    with open(FILE, "a") as f:
        f.write(f"{name},{marks}\n")

    print("Student added successfully!\n")


def view_students():
    if not os.path.exists(FILE):
        print("No data found!\n")
        return

    with open(FILE, "r") as f:
        data = f.readlines()

    if not data:
        print("No students available!\n")
        return

    print("\n--- Student List ---")
    for i, line in enumerate(data):
        name, marks = line.strip().split(",")
        print(f"{i+1}. {name} - {marks}")
    print()


def search_student():
    name_search = input("Enter name to search: ")

    with open(FILE, "r") as f:
        data = f.readlines()

    found = False
    for line in data:
        name, marks = line.strip().split(",")
        if name.lower() == name_search.lower():
            print(f"Found: {name} - {marks}\n")
            found = True

    if not found:
        print("Student not found!\n")


def delete_student():
    name_del = input("Enter name to delete: ")

    with open(FILE, "r") as f:
        data = f.readlines()

    with open(FILE, "w") as f:
        for line in data:
            name, marks = line.strip().split(",")
            if name.lower() != name_del.lower():
                f.write(line)

    print("Student deleted (if existed)\n")


while True:
    print("1. Add Student")
    print("2. View Students")
    print("3. Search Student")
    print("4. Delete Student")
    print("5. Exit")

    choice = input("Enter choice: ")

    if choice == "1":
        add_student()
    elif choice == "2":
        view_students()
    elif choice == "3":
        search_student()
    elif choice == "4":
        delete_student()
    elif choice == "5":
        break
    else:
        print("Invalid choice!\n")
